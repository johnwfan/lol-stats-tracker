# Copy this file to .env.local (or .env) and fill in real values.
# See README.md "Getting Started" for where each of these comes from.

RIOT_API_KEY=your_riot_api_key

MONGODB_URI=your_mongodb_connection_string

UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Draft Intelligence: URL of the FastAPI inference service (ml-service/).
# Local dev: http://localhost:8001
# Production: the deployed ml-service URL -- see README.md "Deployment".
ML_API_URL=http://localhost:8001

# GitHub OAuth sign-in (NextAuth v5)
AUTH_SECRET=your_auth_secret
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret
